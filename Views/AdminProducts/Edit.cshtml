@model lizari.Models.Admin.ProductEditViewModel
@{
    ViewData["Title"] = "Редактирование товара";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Редактирование товара</h1>
            <div class="text-muted">
                ID поставщика: @Model.SupplierProductId
            </div>
        </div>
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Назад
        </a>
    </div>
    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>
        <!-- Д ПоставКА ПОСТАВЩИКА -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Данные поставщика</h2>

                    <button type="submit"
                            asp-action="RefreshSupplier"
                            asp-route-id="@Model.Id"
                            formnovalidate
                            class="btn btn-sm btn-outline-primary">

                        <i class="bi bi-arrow-clockwise"></i>
                        Обновить
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-start">
                    <div class="col-md-3">
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierPicture))
                        {
                            <img src="@Model.SupplierPicture"
                                 class="img-fluid rounded border"
                                 alt="@Model.Title" />
                        }
                    </div>
                    <div class="col-md-9">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">
                                    Цена поставщика
                                </label>
                                <input value="@Model.SupplierPrice.ToString("0.00") ₴"
                                       class="form-control"
                                       readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Остаток</label>
                                <input value="@Model.QuantityInStock"
                                       class="form-control"
                                       readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Наличие</label>
                                <input value="@(Model.Available ? "В наличии" : "Нет в наличии")"
                                       class="form-control"
                                       readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Производитель</label>
                                <input value="@Model.Vendor"
                                       class="form-control"
                                       readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Артикул</label>
                                <input value="@Model.VendorCode"
                                       class="form-control"
                                       readonly />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">
                                    Название у поставщика
                                </label>

                                <input value="@Model.SupplierName"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">
                                    Категория XML
                                </label>

                                <input value="@Model.CategoryId"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    Описание поставщика
                                </label>

                                <textarea class="form-control"
                                          rows="5"
                                          readonly>@Model.SupplierDescription</textarea>
                            </div>
                            <div class="col-12">
                                <small class="text-muted">
                                    Последнее обновление:
                                    @(Model.SupplierUpdatedAt?.ToLocalTime()
                                                                        .ToString("dd.MM.yyyy HH:mm") ?? "не обновлялось")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- ОСНОВНАЯ ИНФОРМАЦИЯ -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Основная информация</h2>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Title"
                           class="form-label">
                        Название
                    </label>
                    <input asp-for="Title"
                           class="form-control" />
                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ShortDescription"
                           class="form-label">
                        Короткое описание
                    </label>
                    <textarea asp-for="ShortDescription"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="ShortDescription"
                          class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Description"
                           class="form-label">
                        Полное описание
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="7"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>
            </div>
        </div>
        <!-- ЦЕНЫ -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Цены</h2>
            </div>
            <div class="card-body">
                <div class="form-check form-switch mb-3">
                    <input asp-for="AutoUpdatePrice"
                           class="form-check-input" />
                    <label asp-for="AutoUpdatePrice"
                           class="form-check-label">
                        Обновлять цену автоматически из XML
                    </label>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Price"
                               class="form-label">
                            Цена продажи
                        </label>
                        <div class="input-group">
                            <input asp-for="Price"
                                   class="form-control"
                                   step="0.01" />
                            <span class="input-group-text">₴</span>
                        </div>
                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DiscountPrice"
                               class="form-label">
                            Цена со скидкой
                        </label>
                        <div class="input-group">
                            <input asp-for="DiscountPrice"
                                   class="form-control"
                                   step="0.01" />
                            <span class="input-group-text">₴</span>
                        </div>
                        <span asp-validation-for="DiscountPrice"
                              class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WholesalePrice"
                               class="form-label">
                            Оптовая цена
                        </label>
                        <div class="input-group">
                            <input asp-for="WholesalePrice"
                                   class="form-control"
                                   step="0.01" />
                            <span class="input-group-text">₴</span>
                        </div>
                        <span asp-validation-for="WholesalePrice"
                              class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <!-- ИЗОБРАЖЕНИЯ -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Дополнительные изображения</h2>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Основное изображение обновляется автоматически.
                    Можно добавить ещё три ссылки.
                </p>
                <div class="mb-3">
                    <label asp-for="AdditionalPicture1"
                           class="form-label">
                        Дополнительное изображение 1
                    </label>
                    <input asp-for="AdditionalPicture1"
                           class="form-control"
                           placeholder="https://..." />
                    <span asp-validation-for="AdditionalPicture1"
                          class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="AdditionalPicture2"
                           class="form-label">
                        Дополнительное изображение 2
                    </label>
                    <input asp-for="AdditionalPicture2"
                           class="form-control"
                           placeholder="https://..." />
                    <span asp-validation-for="AdditionalPicture2"
                          class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="AdditionalPicture3"
                           class="form-label">
                        Дополнительное изображение 3
                    </label>
                    <input asp-for="AdditionalPicture3"
                           class="form-control"
                           placeholder="https://..." />
                    <span asp-validation-for="AdditionalPicture3"
                          class="text-danger"></span>
                </div>
            </div>
        </div>
        <!-- ХАРАКТЕРИСТИКИ -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Характеристики</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Type"
                               class="form-label">
                            Тип
                        </label>
                        <input asp-for="Type"
                               class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Size"
                               class="form-label">
                            Размер
                        </label>
                        <input asp-for="Size"
                               class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Color"
                               class="form-label">
                            Цвет
                        </label>
                        <input asp-for="Color"
                               class="form-control" />
                    </div>
                </div>
            </div>
        </div>
        <!-- ПРЕИМУЩЕСТВА -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Преимущества</h2>
            </div>
            <div class="card-body">
                @for (int number = 1; number <= 4; number++)
                {
                    string titleName = $"Feature{number}Title";
                    string descriptionName =
                    $"Feature{number}Description";
                    <div class="border rounded p-3 mb-3">
                        <h3 class="h6">
                            Преимущество @number
                        </h3>
                        <div class="mb-3">
                            <label class="form-label">
                                Заголовок
                            </label>
                            <input name="@titleName"
                                   value="@ViewData.Eval(titleName)"
                                   class="form-control" />
                        </div>
                        <div>
                            <label class="form-label">
                                Описание
                            </label>
                            <textarea name="@descriptionName"
                                  class="form-control"
                                  rows="2">@ViewData.Eval(descriptionName)</textarea>
                        </div>
                    </div>
                }
            </div>
        </div>
        <!-- БЛОК ПОДБОРА -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Блок подбора</h2>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="SelectionTitle"
                           class="form-label">
                        Заголовок
                    </label>
                    <input asp-for="SelectionTitle"
                           class="form-control" />
                </div>
                <div>
                    <label asp-for="SelectionDescription"
                           class="form-label">
                        Описание
                    </label>
                    <textarea asp-for="SelectionDescription"
                              class="form-control"
                              rows="4"></textarea>
                </div>
            </div>
        </div>
        <!-- ПУБЛИКАЦИЯ -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">

                <div class="d-flex flex-column
                    flex-md-row gap-4">

                    <div class="form-check form-switch">
                        <input asp-for="IsPublished"
                               class="form-check-input">

                        <label asp-for="IsPublished"
                               class="form-check-label fw-semibold">
                            Показывать товар на сайте
                        </label>
                    </div>

                    <div class="form-check form-switch">
                        <input asp-for="IsMainProduct"
                               class="form-check-input">

                        <label asp-for="IsMainProduct"
                               class="form-check-label fw-semibold">
                            Главный товар на первой странице
                        </label>
                    </div>

                </div>

            </div>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="submit"
                    form="deleteProductForm"
                    class="btn btn-outline-danger">
                <i class="bi bi-trash"></i>
                Удалить
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Отмена
            </a>

            <button type="submit"
                    class="btn btn-success px-4">
                <i class="bi bi-check-lg"></i>
                Сохранить
            </button>
        </div>
    </form>

    <form id="deleteProductForm"
          method="post"
          asp-controller="AdminProducts"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          class="delete-product-form">
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-product-edit.js"
            asp-append-version="true"></script>
}