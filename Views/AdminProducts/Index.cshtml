@model IReadOnlyList<lizari.Entities.ProductEntity>

@{
    ViewData["Title"] = "Управление товарами";
}

<div class="container py-4">

    <!-- ЗАГОЛОВОК -->
    <div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center gap-3 mb-4">

        <h1 class="h3 mb-0">
            Товары
        </h1>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="AdminOrders"
               asp-action="Index"
               class="btn btn-outline-dark">

                <i class="bi bi-receipt"></i>
                Заказы

            </a>

            <form method="post"
                  asp-controller="Admin"
                  asp-action="Logout">

                <button class="btn btn-outline-secondary"
                        type="submit">

                    <i class="bi bi-box-arrow-right"></i>
                    Выйти

                </button>

            </form>

        </div>

    </div>

    <!-- СООБЩЕНИЯ -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- ДОБАВЛЕНИЕ ТОВАРА -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h2 class="h5 mb-3">
                Добавить товар поставщика
            </h2>

           <form method="post"
      asp-action="Add"
      class="row g-3">

                <div class="col-md-8">
                    <input type="number"
                           name="supplierProductId"
                           class="form-control"
                           placeholder="Введите ID товара из XML"
                           min="1"
                           required />
                </div>

                <div class="col-md-4">
                    <button type="submit"
                            class="btn btn-dark w-100">

                        <i class="bi bi-plus-lg"></i>
                        Добавить товар
                    </button>
                </div>

            </form>

        </div>
    </div>

    <!-- СИНХРОНИЗАЦИЯ -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="text-muted">
            Найдено товаров: @Model.Count
        </div>

        <form method="post" asp-action="Sync">
            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-arrow-repeat"></i>
                Обновить цены и остатки
            </button>
        </form>

    </div>

    <!-- СПИСОК ТОВАРОВ -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle mb-0">

                   <thead class="table-light">
    <tr>
        <th>Фото</th>
        <th></th>
        <th>ID поставщика</th>
        <th>Название</th>
        <th>Цена на сайте</th>
        <th>Цена поставщика</th>
        <th>Оптовая цена</th>
        <th>Остаток</th>
        <th>Наличие</th>
        <th>Статус</th>
    </tr>
</thead>

                    <tbody>

                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="10"
                                    class="text-center text-muted py-5">

                                    Товары ещё не добавлены
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in Model)
                            {
                                <tr>

                                    <!-- РЕДАКТИРОВАНИЕ -->
                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-dark"
                                           title="Редактировать"
                                           aria-label="Редактировать товар">

                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(product.Picture))
                                        {
                                            <img src="@product.Picture"
                                                 width="56"
                                                 height="56"
                                                 class="rounded border object-fit-cover"
                                                 alt="@product.Title" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center
                                bg-light border rounded text-muted"
                                                 style="width: 56px; height: 56px;">

                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                    </td>
                                    <!-- ID ПОСТАВЩИКА -->
                                    <td>
                                        @product.SupplierProductId
                                    </td>

                                    <!-- НАЗВАНИЕ -->
                                    <td>
                                        <div class="fw-semibold">
                                            @product.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(product.VendorCode))
                                        {
                                            <small class="text-muted">
                                                Артикул: @product.VendorCode
                                            </small>
                                        }
                                    </td>

                                    <!-- ЦЕНА НА САЙТЕ -->
                                    <!-- ЦЕНА НА САЙТЕ -->
                                    <td>
                                        @if (product.DiscountPrice is > 0)
                                        {
                                            <div class="fw-semibold text-danger">
                                                @product.DiscountPrice.Value.ToString("0.00") ₴
                                            </div>

                                            <small class="text-muted text-decoration-line-through">
                                                @product.Price.ToString("0.00") ₴
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">
                                                @product.Price.ToString("0.00") ₴
                                            </span>
                                        }
                                    </td>

                                    <!-- ЦЕНА ПОСТАВЩИКА -->
                                    <td>
                                        @product.SupplierPrice.ToString("0.00") ₴
                                    </td>
                                    <!-- ЦЕНА ПОСТАВЩИКА оптовая-->
                                    <td>
                                        @if (product.WholesalePrice > 0)
                                        {
                                            <span>
                                                @product.WholesalePrice.ToString("0.00") ₴
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Не указана
                                            </span>
                                        }
                                    </td>
                                    <!-- ОСТАТОК -->
                                    <td>
                                        @product.QuantityInStock шт.
                                    </td>

                                    <!-- НАЛИЧИЕ -->
                                    <td>
                                        @if (product.Available)
                                        {
                                            <span class="badge bg-success">
                                                В наличии
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Нет в наличии
                                            </span>
                                        }
                                    </td>

                                    <!-- ПУБЛИКАЦИЯ -->
                                    <td>
                                        @if (product.IsPublished)
                                        {
                                            <span class="badge bg-success">
                                                Опубликован
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Черновик
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>

</div>