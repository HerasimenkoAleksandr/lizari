@using lizari.Entities
@model OrderEntity

@{
    ViewData["Title"] = "Замовлення прийнято";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5 text-center">

                    <div class="display-4 text-success mb-3">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <h1 class="h2 fw-bold mb-3">
                        Замовлення прийнято
                    </h1>

                    <p class="text-secondary mb-4">
                        Дякуємо! Ми зв’яжемося з вами
                        для підтвердження замовлення.
                    </p>

                    <div class="bg-light rounded-4 p-4 mb-4">

                        <div class="text-secondary mb-1">
                            Номер замовлення
                        </div>

                        <div class="h4 fw-bold mb-0">
                            @Model.OrderNumber
                        </div>

                    </div>


                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex
                                        justify-content-between
                                        text-start border-bottom py-3">

                            <div>

                                <div class="fw-semibold">
                                    @item.ProductTitle
                                </div>

                                <div class="small text-secondary">
                                    @item.Quantity шт.
                                    ×
                                    @item.UnitPrice.ToString("N0") ₴
                                </div>

                            </div>

                            <div class="fw-bold">
                                @item.TotalPrice.ToString("N0") ₴
                            </div>

                        </div>
                    }


                    <div class="d-flex
                                justify-content-between
                                align-items-center py-4">

                        <span class="fw-semibold">
                            Разом:
                        </span>

                        <span class="fs-3 fw-bold">
                            @Model.TotalPrice.ToString("N0") ₴
                        </span>

                    </div>


                    <div class="text-start bg-light rounded-4 p-4 mb-4">

                        <p class="mb-2">
                            <strong>Отримувач:</strong>
                            @Model.RecipientName
                        </p>

                        <p class="mb-2">
                            <strong>Телефон:</strong>
                            @Model.RecipientPhone
                        </p>

                        <p class="mb-2">
                            <strong>Місто:</strong>
                            @Model.City
                        </p>

                        <p class="mb-2">
                            <strong>Доставка:</strong>
                            @Model.DeliveryMethod
                        </p>

                        <p class="mb-0">
                            <strong>Відділення або адреса:</strong>
                            @Model.DeliveryAddress
                        </p>

                    </div>


                    <a asp-controller="Pet"
                       asp-action="Index"
                       class="btn btn-dark rounded-pill px-5">
                        Повернутися до товарів
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>