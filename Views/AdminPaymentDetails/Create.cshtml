@model lizari.Models.Admin.PaymentDetailsEditViewModel

@{
    ViewData["Title"] = "Додати реквізити";
}

<div class="container py-4">

    <div class="mb-4">

        <a asp-controller="AdminPaymentDetails"
           asp-action="Index"
           class="text-decoration-none text-secondary">

            <i class="bi bi-arrow-left"></i>
            Назад до реквізитів

        </a>

        <h1 class="h3 fw-bold mt-2 mb-0">
            Додати реквізити
        </h1>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <form method="post"
                  asp-controller="AdminPaymentDetails"
                  asp-action="Create">

                <partial name="_Form"
                         model="Model" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="AdminPaymentDetails"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Скасувати

                    </a>

                    <button type="submit"
                            class="btn btn-dark px-4">

                        <i class="bi bi-check-lg"></i>
                        Зберегти

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/admin-payment-details.js"
            asp-append-version="true">
    </script>

}