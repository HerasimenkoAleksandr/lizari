                     class="footer-logo">

                <span class="fw-normal fs-8 ms-2">
                    Pet
                </span>

            </div>

            <div class="small">
                © 2026 LIZARI. Усі права захищені.
            </div>

        </div>

    </div>
</footer>


@section Scripts {
    <script src="~/js/pet.js"
            asp-append-version="true"></script>
}