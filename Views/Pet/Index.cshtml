@model IReadOnlyList<lizari.Entities.ProductEntity>

@{
    ViewData["Title"] = "LIZARI Pet";

    // Товар, выбранный главным в админке
    var product = Model.FirstOrDefault(
        item => item.IsMainProduct);

    // Если главный товар не назначен,
    // показываем первый опубликованный
       product ??= Model.FirstOrDefault();

    var otherProducts = product is null
        ? new List<lizari.Entities.ProductEntity>()
        : Model
            .Where(item => item.Id != product.Id)
            .Take(4)
            .ToList();
}

@if (product is null)
{
    <div class="container py-5">
        <div class="alert alert-warning">
            Опубліковані товари не знайдено.
        </div>
    </div>

    return;
}

@{
    var productImages = new[]
    {
        product.Picture,
        product.AdditionalPicture1,
        product.AdditionalPicture2,
        product.AdditionalPicture3
    }
    .Where(image => !string.IsNullOrWhiteSpace(image))
    .Select(image => image!)
    .Distinct()
    .ToList();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Petcss/pet.css"
          asp-append-version="true" />
}


<!-- HEADER -->

<nav class="navbar navbar-expand-lg bg-white shadow-sm">
    <div class="upal container">

        <a class="navbar-brand d-flex align-items-center"
           asp-controller="Pet"
           asp-action="Index">

            <img src="~/pictures/logo3.png"
                 alt="LIZARI"
                 class="navbar-logo">

            <span class="fw-normalnub fs-7 ms-2 text-dark">
                Pet
            </span>
        </a>

        @if (product.Available)
        {
            <a href="#buy"
               class="btn btn-dark rounded-pill px-4">
                Купити
            </a>
        }

    </div>
</nav>


<!-- HERO -->

<section class="hero py-5">
    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                @if (productImages.Count > 0)
                {
                    <div id="productImageCarousel"
                         class="carousel slide product-carousel"
                         data-bs-ride="false"
                         data-bs-touch="true">

                        @if (productImages.Count > 1)
                        {
                            <div class="carousel-indicators">

                                @for (int index = 0;
                                                        index < productImages.Count;
                                                        index++)
                                {
                                    <button type="button"
                                            data-bs-target="#productImageCarousel"
                                            data-bs-slide-to="@index"
                                            class="@(index == 0 ? "active" : "")"
                                            aria-current="@(index == 0 ? "true" : null)"
                                            aria-label="Фото @(index + 1)">
                                    </button>
                                }

                            </div>
                        }

                        <div class="carousel-inner shadow-sm">

                            @for (int index = 0;
                                                    index < productImages.Count;
                                                    index++)
                            {
                                <div class="carousel-item @(index == 0 ? "active" : "")">

                                    <img src="@productImages[index]"
                                         class="hero-image d-block w-100"
                                         alt="@product.Title — фото @(index + 1)">

                                </div>
                            }

                        </div>

                        @if (productImages.Count > 1)
                        {
                            <button class="carousel-control-prev"
                                    type="button"
                                    data-bs-target="#productImageCarousel"
                                    data-bs-slide="prev">

                                <span class="carousel-control-prev-icon"
                                      aria-hidden="true">
                                </span>

                                <span class="visually-hidden">
                                    Попереднє фото
                                </span>

                            </button>

                            <button class="carousel-control-next"
                                    type="button"
                                    data-bs-target="#productImageCarousel"
                                    data-bs-slide="next">

                                <span class="carousel-control-next-icon"
                                      aria-hidden="true">
                                </span>

                                <span class="visually-hidden">
                                    Наступне фото
                                </span>

                            </button>
                        }

                    </div>
                }
                else
                {
                    <div class="alert alert-light text-center">
                        Фото товару відсутнє
                    </div>
                }

            </div>

            <div class="col-lg-6">

                @if (product.Available)
                {
                    <span class="badge bg-success mb-3">
                        В наявності
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary mb-3">
                        Немає в наявності
                    </span>
                }

                <h1 class="display-5 fw-bold mb-3">
                    @product.Title
                </h1>

                @if (!string.IsNullOrWhiteSpace(
                                product.ShortDescription))
                {
                    <div class="product-description-wrapper">

                        <p id="productDescription"
                           class="lead text-secondary product-description">
                            @product.ShortDescription
                        </p>

                        <button type="button"
                                id="descriptionToggle"
                                class="description-toggle">
                            Читати далі
                        </button>

                    </div>
                }

                <div class="mt-4">

                    @if (!string.IsNullOrWhiteSpace(
                                        product.VendorCode))
                    {
                        <p class="mb-1">
                            <strong>Артикул:</strong>
                            @product.VendorCode
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(product.Size))
                    {
                        <p class="mb-1">
                            <strong>Розмір:</strong>
                            @product.Size
                        </p>
                    }

                    <p>
                        <strong>Колір:</strong>
                        @product.Color
                    </p>

                </div>


               <!-- PRICE -->

<div class="mt-4 mb-4">

                    <!-- Цена -->
                    @if (product.Available)
                    {
                        <div class="mt-4 mb-4">

                            @if (product.DiscountPrice is > 0)
                            {
                                <div class="d-flex flex-wrap
                                    align-items-center gap-3">

                                    <span class="price text-danger">
                                        @product.DiscountPrice.Value.ToString("N0") ₴
                                    </span>

                                    <span class="old-price-wrapper">

                                        <span class="text-secondary
                                             text-decoration-line-through
                                             fs-5">
                                            @product.Price.ToString("N0") ₴
                                        </span>

                                        @if (product.DiscountPercent is > 0)
                                        {
                                            <span class="discount-corner">
                                                -@product.DiscountPercent.Value.ToString("N0")%
                                            </span>
                                        }

                                    </span>

                                </div>
                            }
                            else
                            {
                                <div class="price">
                                    @product.Price.ToString("N0") ₴
                                </div>
                            }

                        </div>

                        <a asp-controller="Orders"
                           asp-action="Create"
                           asp-route-productId="@product.Id"
                           class="btn btn-dark btn-buy rounded-pill px-5">
                            Оформити замовлення
                        </a>

                        <p class="small-muted mt-3">
                            Доставка Новою Поштою по Україні
                        </p>
                    }
                    else
                    {
                        <div class="price text-secondary
                                        opacity-25 mt-4 mb-4">

                            @if (product.DiscountPrice is > 0)
                            {
                                @product.DiscountPrice.Value.ToString("N0")
                            }
                            else
                            {
                                @product.Price.ToString("N0")
                            }

                            ₴
                        </div>
                    }

</div>

    </div>
</section>


<!-- FEATURES -->
@if (!string.IsNullOrWhiteSpace(product.Feature1Title) ||
     !string.IsNullOrWhiteSpace(product.Feature2Title) ||
     !string.IsNullOrWhiteSpace(product.Feature3Title) ||
     !string.IsNullOrWhiteSpace(product.Feature4Title))
{
    <section class="py-5">
        <div class="container">

            <div class="text-center mb-5">

                <h2 class="fw-bold">
                    Чому улюбленцю буде зручно
                </h2>

                <p class="text-secondary">
                    Продумана конструкція для щоденного відпочинку
                </p>

            </div>

            <div class="row g-4">

                @if (!string.IsNullOrWhiteSpace(
                            product.Feature1Title))
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="feature-card shadow-sm h-100">

                            <h4>
                                ✓ @product.Feature1Title
                            </h4>

                            <p class="text-secondary mb-0">
                                @product.Feature1Description
                            </p>

                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
                            product.Feature2Title))
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="feature-card shadow-sm h-100">

                            <h4>
                                ✓ @product.Feature2Title
                            </h4>

                            <p class="text-secondary mb-0">
                                @product.Feature2Description
                            </p>

                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
                            product.Feature3Title))
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="feature-card shadow-sm h-100">

                            <h4>
                                ✓ @product.Feature3Title
                            </h4>

                            <p class="text-secondary mb-0">
                                @product.Feature3Description
                            </p>

                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
                            product.Feature4Title))
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="feature-card shadow-sm h-100">

                            <h4>
                                ✓ @product.Feature4Title
                            </h4>

                            <p class="text-secondary mb-0">
                                @product.Feature4Description
                            </p>

                        </div>

                    </div>
                }

            </div>

        </div>
    </section>
}


<!-- PRODUCT DESCRIPTION -->
@if (!string.IsNullOrWhiteSpace(product.Description))
{
    <section class="product-section py-5">
        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <h2 class="fw-bold mb-4 text-center">
                        Детальніше про товар
                    </h2>

                    <p class="fs-5 text-secondary">
                        @product.Description
                    </p>

                </div>

            </div>

        </div>
    </section>
}


<!-- CHARACTERISTICS -->

<section class="py-5">
    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <h2 class="fw-bold">

                    @if (!string.IsNullOrWhiteSpace(
                                        product.SelectionTitle))
                    {
                        @product.SelectionTitle
                    }
                    else
                    {
                        <text>
                            Обирайте комфорт для вашого улюбленця
                        </text>
                    }

                </h2>

                @if (!string.IsNullOrWhiteSpace(
                                product.SelectionDescription))
                {
                    <p class="fs-5 text-secondary mt-3">
                        @product.SelectionDescription
                    </p>
                }
                else
                {
                    <p class="fs-5 text-secondary mt-3">
                        Перед замовленням зверніть увагу
                        на розмір та характеристики товару.
                    </p>

                    <p class="fs-5 text-secondary">
                        Якщо потрібна допомога —
                        ми допоможемо підібрати відповідний варіант.
                    </p>
                }

            </div>

            <div class="col-lg-6">

                <div class="buy-box p-5">

                    <h4 class="fw-bold">
                        Характеристики
                    </h4>

                    <hr>

                    @if (!string.IsNullOrWhiteSpace(product.Type))
                    {
                        <p>
                            <strong>Тип:</strong>
                            @product.Type
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(product.Size))
                    {
                        <p>
                            <strong>Розмір:</strong>
                            @product.Size
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(product.Color))
                    {
                        <p>
                            <strong>Колір:</strong>
                            @product.Color
                        </p>
                    }

                   @*  @if (!string.IsNullOrWhiteSpace(product.Vendor))
                    {
                        <p>
                            <strong>Виробник:</strong>
                            @product.Vendor
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(
                                        product.VendorCode))
                    {
                        <p>
                            <strong>Артикул:</strong>
                            @product.VendorCode
                        </p>
                    }

                    <p>
                        <strong>Кількість:</strong>
                        @product.QuantityInStock шт.
                    </p>
 *@
                    <p>
                        <strong>Наявність:</strong>

                        @if (product.Available)
                        {
                            <span class="text-success">
                                є в наявності
                            </span>
                        }
                        else
                        {
                            <span class="text-secondary">
                                немає в наявності
                            </span>
                        }
                    </p>

                    <p class="mb-0">
                        <strong>Доставка:</strong>
                        Нова Пошта
                    </p>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- OTHER PRODUCTS -->
@if (otherProducts.Count > 0)
{
    <section class="product-section py-5">
        <div class="container">

            <div class="text-center mb-5">

                <h2 class="fw-bold">
                    Вам також може сподобатися
                </h2>

                <p class="text-secondary">
                    Інші товари для комфорту вашого улюбленця
                </p>

            </div>

            <div class="row g-4 justify-content-center">

                @foreach (var item in otherProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3">

                        <div class="product-card h-100">

                            <div class="product-card-image
                                                position-relative">

                                <img src="@item.Picture"
                                     class="img-fluid w-100"
                                     alt="@item.Title">

                                @if (item.Available)
                                {
                                    <span class="badge bg-success
                                                             text-white
                                                             position-absolute
                                                             top-0 start-0 m-2">
                                        В наявності
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary
                                                             text-white
                                                             position-absolute
                                                             top-0 start-0 m-2">
                                        Не в наявності
                                    </span>
                                }

                                @if (item.DiscountPercent is > 0)
                                {
                                    <span class="badge bg-danger
                                                             position-absolute
                                                             top-0 end-0 m-2">
                                        -@item.DiscountPercent.Value.ToString("N0")%
                                    </span>
                                }

                            </div>

                            <div class="pt-3">
                                <h3 class="h6 fw-bold product-card-title mb-1">
                                    @item.Title
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(item.VendorCode))
                                {
                                    <p class="small text-secondary mt-0 mb-2">
                                        Артикул: @item.VendorCode
                                    </p>
                                }

                                <div class="mb-3">

                                    @if (item.DiscountPrice is > 0)
                                    {
                                        <span class="fw-bold fs-5
                                                                 text-danger">
                                            @item.DiscountPrice.Value.ToString("N0") ₴
                                        </span>

                                        <span class="small text-secondary
                                                                 text-decoration-line-through
                                                                 ms-2">
                                            @item.Price.ToString("N0") ₴
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold fs-5">
                                            @item.Price.ToString("N0") ₴
                                        </span>
                                    }

                                </div>

                                <a asp-controller="Pet"
                                   asp-action="Product"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-dark
                                                  rounded-pill w-100">
                                    Переглянути
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    </section>
}


